# Copy this file to ".env" and fill in your own values. Never commit ".env".

APP_ENV=development
# Set to production when you deploy (hides error details, makes session cookies "secure" on https)

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=colm_registrar
DB_USER=root
DB_PASS=

SESSION_NAME=COLM_SESSID

# Where uploaded files are stored. Leave empty to use the "storage/uploads" folder.
# On a real server use a folder OUTSIDE the public web root, for example /var/www/colm_uploads
UPLOAD_DIR=

# ---------------------------------------------------------------
# FREE AI (no API key, no credit card, nothing is sent to the internet)
# ---------------------------------------------------------------
# 1) Document checking uses Tesseract OCR (free). Install it, then check the path below.
#    Windows: install "Tesseract OCR" (UB Mannheim build). Default folder: C:\Program Files\Tesseract-OCR\tesseract.exe
#    Leave as "tesseract" if the command works in a terminal.
TESSERACT_PATH=tesseract
# PDF files need "poppler" (pdftotext + pdftoppm). Put the folder of those programs here (the "bin" folder),
# or leave empty if they work in a terminal. Pictures (JPG/PNG) do not need poppler.
POPPLER_PATH=

# 2) The chatbot uses Ollama (free). Install it from https://ollama.com, then run once:  ollama pull llama3.2:3b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# A small computer may need more time (seconds):
OLLAMA_TIMEOUT=90

# Picture quality check (no tools needed). A picture is DECLINED when its sharpness is below BLUR_THRESHOLD or its
# average brightness (0-255) is below DARK_THRESHOLD. Raise BLUR_THRESHOLD to be stricter, lower it if good scans are declined.
BLUR_THRESHOLD=30
DARK_THRESHOLD=40

# Used only by database/install.php when APP_ENV=production: the first admin password (min. 10 characters)
INITIAL_ADMIN_PASSWORD=
